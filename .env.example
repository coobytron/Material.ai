# All optional. Material.ai runs fully offline with none of these set.

# Claude mode. Also requires: npm install @anthropic-ai/sdk
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Mistral through any local OpenAI-compatible server. No key, no SDK, no network.
# Ollama: http://127.0.0.1:11434/v1 (default)  LM Studio: http://127.0.0.1:1234/v1
# llama.cpp: http://127.0.0.1:8080/v1          vLLM: http://127.0.0.1:8000/v1
MISTRAL_BASE_URL=http://127.0.0.1:11434/v1
# Leave MISTRAL_MODEL unset to auto-detect the installed Mistral build, tag and
# all (e.g. mistral-small3.1:latest). Set it only to pin a specific model.
MISTRAL_MODEL=
# Only needed by servers that require one (LM Studio, vLLM). Ollama does not.
MISTRAL_API_KEY=
MISTRAL_TIMEOUT_MS=120000

PORT=3000
